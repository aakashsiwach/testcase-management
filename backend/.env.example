# Server
NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/testcase_mgmt
# Set to true on hosted Postgres that requires SSL (e.g. Render external URL, Neon)
DATABASE_SSL=false

# Redis (Render Key Value internal URL in production)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# CORS: frontend origin(s), comma-separated
CORS_ORIGIN=http://localhost:5173

# Rate limits (defaults match the brief)
RATE_LIMIT_AUTH_MAX=5            # per 15 minutes
RATE_LIMIT_TESTCASE_MAX=100      # per hour
RATE_LIMIT_EXECUTION_MAX=200     # per hour
RATE_LIMIT_ANALYTICS_MAX=50      # per hour

# Cache TTLs in seconds (defaults match the brief)
CACHE_TTL_ANALYTICS=900          # 15 minutes
CACHE_TTL_SUITES=1800            # 30 minutes
CACHE_TTL_PROJECT=3600           # 1 hour

# Uploads
MAX_UPLOAD_MB=5

# Optional: email notifications for test assignments (logged to console if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Test Case Manager <no-reply@example.com>"
