# ---------------------------------------------------------------
# Local development (copy to .env). Production values: see bottom.
# ---------------------------------------------------------------
NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/testcase_mgmt
# true for hosted Postgres that requires SSL (Neon, Render external URL)
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Redis (leave empty to run without cache; the API falls back to Postgres)
REDIS_URL=redis://localhost:6379

# Auth (production: at least 32 random characters, e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# CORS: allowed frontend origin(s), comma-separated, no trailing slash
CORS_ORIGIN=http://localhost:5173
# Public URL of the frontend (used in assignment emails)
APP_URL=http://localhost:5173

# Rate limits (defaults match the brief)
RATE_LIMIT_AUTH_MAX=5            # per 15 minutes, per IP + email
RATE_LIMIT_TESTCASE_MAX=100      # per hour, per user
RATE_LIMIT_EXECUTION_MAX=200     # per hour, per user
RATE_LIMIT_ANALYTICS_MAX=50      # per hour, per user
RATE_LIMIT_GENERAL_MAX=300       # per 15 minutes, per user

# Cache TTLs in seconds (defaults match the brief)
CACHE_TTL_ANALYTICS=900          # 15 minutes
CACHE_TTL_SUITES=1800            # 30 minutes
CACHE_TTL_PROJECT=3600           # 1 hour

# Uploads (stored in Postgres, max 5 files per request)
MAX_UPLOAD_MB=5

# Optional: email notifications for test assignments (logged to console if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Test Case Manager <no-reply@example.com>"

# Tests only (npm test): defaults to DATABASE_URL with database "testcase_test" and Redis DB 15
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/testcase_test

# ---------------------------------------------------------------
# Production example (Render web service + Neon + Upstash)
# ---------------------------------------------------------------
# NODE_ENV=production
# DATABASE_URL=postgresql://<user>:<password>@<endpoint>.neon.tech/<db>?sslmode=require
# DATABASE_SSL=true
# DATABASE_POOL_MAX=5
# REDIS_URL=rediss://default:<password>@<name>.upstash.io:6379
# JWT_SECRET=<64 hex chars>
# CORS_ORIGIN=https://<your-app>.vercel.app
# APP_URL=https://<your-app>.vercel.app
